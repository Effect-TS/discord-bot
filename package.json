{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a",
  "scripts": {
    "prepare": "husky && effect-tsgo patch",
    "clean": "node scripts/clean.mjs",
    "build": "pnpm --recursive --parallel --filter \"./packages/**/*\" run build",
    "test": "vitest",
    "check": "oxlint -c .oxlintrc.json --fix && tsc -b tsconfig.json",
    "lint-fix": "oxlint -c .oxlintrc.json --fix"
  },
  "devDependencies": {
    "@effect/tsgo": "0.24.2",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "dfx": "catalog:",
    "effect": "4.0.0-beta.105",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "unrs-resolver"
    ],
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
